# Workspace .env — copy to the trusted clone root you run oh-my-cli from,
# e.g. ~/oh-my-cli/.env  (<cwd>/.env). chmod 600 after writing a real key.
#
# Loaded only after --trust / --trust-workspace. Process env OPENAI_* wins.
# ~/.oh-my-cli/settings.json can supply model.name / model.baseUrl / model.apiKeyEnv.
#
# Do NOT put this file at ~/.oh-my-cli/.env — that directory holds settings.json
# and sessions only. oh-my-cli never loads ~/.oh-my-cli/.env for model config.
#
# Never commit real keys.

OPENAI_API_KEY=sk-your-key-here
# Token Plan / Bailian Token Plan (preferred). dashscope-intl also works when it matches the key:
OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-max
# optional alias used by settings.json apiKeyEnv (process env, not ~/.oh-my-cli/.env):
# DASHSCOPE_API_KEY=sk-your-key-here
